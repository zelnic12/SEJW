# ── Sinar Elektronik — server environment ─────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.

# ── Database (PostgreSQL) ──
# Either a single DATABASE_URL...
# DATABASE_URL=postgres://user:pass@localhost:5432/voltedge
# ...or the discrete vars:
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=voltedge

# ── Server ──
PORT=3000
# Set NODE_ENV=production on live deployments. The destructive demo seeds
# (`npm run seed`, `npm run seed:orders`) refuse to run when it's "production",
# so real catalog and order data can't be wiped by accident. Left commented out
# on purpose: an uncommented NODE_ENV=development here would be copied into a
# production .env and quietly disable that guard.
# NODE_ENV=production

# ── Admin auth (JWT) ──
# Set a strong random secret in production.
JWT_SECRET=change-me-in-production
JWT_TTL=8h
# Bootstrap admin (created on first boot if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Store Admin

# ── Cloudinary (image storage) ──
# Product and banner images are uploaded to Cloudinary, not to local disk, so
# they survive redeploys on hosts with an ephemeral filesystem (Railway, Render…).
# Credentials come from your Cloudinary dashboard (Settings → API Keys).
# Leave blank for local dev: uploads then return a clear 503 and the rest of the
# app keeps working (existing image URLs are unaffected).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: root folder used for uploaded assets (default: sinar-elektronik).
CLOUDINARY_FOLDER=sinar-elektronik

# ── Midtrans payment gateway (Snap) ──
# Get keys from your Midtrans dashboard (Settings → Access Keys).
# Leave blank to run WITHOUT a live gateway (orders are placed but no payment
# transaction is created — useful for local dev / demos).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = Sandbox (default, safe for local dev). Set to true ONLY in production.
MIDTRANS_IS_PRODUCTION=false
