{
  "name": "voltedge-server",
  "version": "1.0.0",
  "description": "VoltEdge electronics store — Express REST API (products + orders)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build:frontend": "node scripts/copy-frontend.js",
    "prestart": "npm run build:frontend",
    "start": "node src/index.js",
    "dev": "npm run build:frontend && node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:images": "node src/db/migrate-images-to-cloudinary.js",
    "seed": "node src/db/seed.js",
    "seed:orders": "node src/db/seed-orders.js",
    "seed:admin": "node src/db/seed-admin.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js && node src/db/seed-admin.js",
    "db:demo": "node src/db/migrate.js && node src/db/seed.js && node src/db/seed-orders.js && node src/db/seed-admin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "midtrans-client": "^1.4.3",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.1"
  }
}
